// Based on: https://github.com/prenone/platformio-vscode-devcontainer/tree/master
{
	"name": "Yoass:Dev Container",
	"build": {
		"dockerfile": "Containerfile",
		"context": ".",
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"platformio.platformio-ide"
			]
		}
	},
	"forwardPorts": [
		8008
	],
	"mounts": [
		"source=/dev/,target=/dev/,type=bind,consistency=consistent",
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,readonly,type=bind"
	],
	"runArgs": [
		"--privileged"
	],
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	"features": {},
	"postAttachCommand": "sudo service udev restart"
}